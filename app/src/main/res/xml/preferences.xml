<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Quick access" app:iconSpaceReserved="false">
        <ListPreference
            app:key="settings_button"
            app:title="Floating settings button (when the Xbox header is hidden)"
            app:entries="@array/gear_entries"
            app:entryValues="@array/gear_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="settings_button_pos"
            app:title="Button position"
            app:entries="@array/gear_pos_entries"
            app:entryValues="@array/gear_pos_values"
            app:defaultValue="bottom_right"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="help"
            app:title="Other ways in"
            app:summary="Tap the gear next to Search at the top of the Xbox page. You can also hold View/Select for 1 second, or press Back."
            app:selectable="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Engine" app:iconSpaceReserved="false">
        <ListPreference
            app:key="engine"
            app:title="Streaming engine"
            app:entries="@array/engine_entries"
            app:entryValues="@array/engine_values"
            app:defaultValue="betterxcloud"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="bx_info"
            app:title="Advanced settings"
            app:summary="Resolution, codec, bitrate, server, upscaling (AMD FSR/CAS), stats, mouse and keyboard and more. Open them from the settings button at the top of the Xbox page."
            app:selectable="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:key="cat_stream" app:title="Stream quality (Basic engine)" app:iconSpaceReserved="false">
        <ListPreference
            app:key="resolution"
            app:title="Resolution"
            app:entries="@array/resolution_entries"
            app:entryValues="@array/resolution_values"
            app:defaultValue="1080p"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="codec"
            app:title="Video codec profile"
            app:entries="@array/codec_entries"
            app:entryValues="@array/codec_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="max_bitrate"
            app:title="Max bitrate"
            app:entries="@array/bitrate_entries"
            app:entryValues="@array/bitrate_values"
            app:defaultValue="0"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="region"
            app:title="Server region"
            app:defaultValue="auto"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="video_fit"
            app:title="Screen fit"
            app:entries="@array/fit_entries"
            app:entryValues="@array/fit_values"
            app:defaultValue="contain"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="show_stats"
            app:title="Show stream stats"
            app:summary="Resolution, FPS, ping, bitrate, packet loss and decode time"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Remote Play" app:iconSpaceReserved="false">
        <ListPreference
            app:key="remote_play_mode"
            app:title="Connection"
            app:entries="@array/rp_entries"
            app:entryValues="@array/rp_values"
            app:defaultValue="standard"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Clarity boost" app:iconSpaceReserved="false">
        <ListPreference
            app:key="clarity_preset"
            app:title="Preset"
            app:entries="@array/clarity_entries"
            app:entryValues="@array/clarity_values"
            app:defaultValue="off"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="clarity_algo"
            app:title="Algorithm"
            app:entries="@array/algo_entries"
            app:entryValues="@array/algo_values"
            app:defaultValue="sharpen"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="sharpness"
            app:title="Sharpness"
            android:max="10"
            app:min="0"
            app:defaultValue="0"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="saturation"
            app:title="Saturation (%)"
            android:max="200"
            app:min="50"
            app:seekBarIncrement="5"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="contrast"
            app:title="Contrast (%)"
            android:max="200"
            app:min="50"
            app:seekBarIncrement="5"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="brightness"
            app:title="Brightness (%)"
            android:max="150"
            app:min="50"
            app:seekBarIncrement="5"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Controls" app:iconSpaceReserved="false">
        <ListPreference
            app:key="controller_input"
            app:title="Controller input"
            app:entries="@array/input_entries"
            app:entryValues="@array/input_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="rumble"
            app:title="Rumble"
            app:entries="@array/rumble_entries"
            app:entryValues="@array/rumble_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="rumble_strength"
            app:title="Rumble strength (%)"
            android:max="100"
            app:min="10"
            app:seekBarIncrement="10"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <ListPreference
            app:key="touch_mode"
            app:title="On-screen touch controls"
            app:entries="@array/touch_entries"
            app:entryValues="@array/touch_values"
            app:defaultValue="auto"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="touch_opacity"
            app:title="Touch controls opacity (%)"
            android:max="100"
            app:min="10"
            app:seekBarIncrement="5"
            app:defaultValue="60"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <SeekBarPreference
            app:key="touch_size"
            app:title="Touch controls size (%)"
            android:max="150"
            app:min="50"
            app:seekBarIncrement="5"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="touch_reset"
            app:title="Reset touch layout"
            app:summary="To move or resize buttons, use Edit touch layout in the menu during a game"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Performance" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="fast_art"
            app:title="Faster page loading"
            app:summary="Downloads game artwork as smaller images so pages fill in quicker"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="low_latency"
            app:title="Low-latency mode"
            app:summary="Smallest video and audio buffer for the quickest response. Turn off if the stream stutters on a weak connection."
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="max_refresh"
            app:title="Highest refresh rate"
            app:summary="Run the screen at its fastest mode for smoother menus and input"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="wifi_low_latency"
            app:title="Low-latency Wi-Fi"
            app:summary="Stops Wi-Fi power saving while the app is open (less lag and stutter)"
            app:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            app:key="sustained_perf"
            app:title="Sustained performance mode"
            app:summary="Steadier clocks for long sessions, if your device supports it"
            app:defaultValue="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="App" app:iconSpaceReserved="false">
        <EditTextPreference
            app:key="start_url"
            app:title="Start page"
            app:defaultValue="https://www.xbox.com/en-us/play"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="reset"
            app:title="Reset settings to defaults"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="clear_data"
            app:title="Sign out and clear data"
            app:summary="Removes cookies, cache, saved logins and advanced settings"
            app:iconSpaceReserved="false" />
        <Preference
            app:key="about"
            app:title="Made by whistlow"
            app:summary="github.com/whistlow"
            app:selectable="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
</PreferenceScreen>
